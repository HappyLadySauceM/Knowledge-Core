{
  "name": "@knowledge-core/collaboration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:code": "eslint . --max-warnings=0",
    "lint": "npm run format:check && npm run lint:code",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run audit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@hocuspocus/extension-redis": "4.4.0",
    "@hocuspocus/server": "4.4.0",
    "@tiptap/core": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@nats-io/transport-node": "3.4.0",
    "pg": "8.22.0",
    "uuid": "14.0.1",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.20.3",
    "eslint": "9.39.2",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
