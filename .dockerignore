# Candidate Dockerfiles only need the selected verified binary, their runtime
# configuration, and the Dockerfile itself. Keep source and vendored Rust
# crates out of every BuildKit context.
*
!.dockerignore
!.ci-artifacts/
!.ci-artifacts/**
!docker/
!docker/**
!services/
!services/*/
!services/*/etc/
!services/*/etc/config.yaml
