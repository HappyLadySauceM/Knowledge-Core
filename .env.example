# Required by docker/infrastructure/docker-compose.yml.
KC_POSTGRES_PASSWORD=

# Runtime providers and connections.
KC_ENV=local
KC_DATABASE_PROVIDER=postgres
KC_DATABASE_DSN=
KC_CACHE_PROVIDER=redis
KC_CACHE_ENDPOINTS=127.0.0.1:6379
KC_MESSAGING_DURABLE_PROVIDER=nats
KC_MESSAGING_REALTIME_PROVIDER=nats
KC_NATS_URL=nats://127.0.0.1:4222
KC_CONFIG_PROVIDER=etcd
KC_ETCD_ENDPOINTS=127.0.0.1:2379

# Service listeners.
KC_GATEWAY_HTTP_ADDR=:8080
KC_IDENTITY_RPC_ADDR=:8881
KC_KNOWLEDGE_RPC_ADDR=:8882
KC_PLATFORM_RPC_ADDR=:8883
