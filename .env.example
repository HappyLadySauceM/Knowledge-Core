# Required by docker/infrastructure/docker-compose.yml.
KC_POSTGRES_PASSWORD=

# Runtime providers and connections.
KC_ENV=local
KC_DATABASE_PROVIDER=postgres
KC_DATABASE_DSN=
KC_CACHE_PROVIDER=redis
KC_CACHE_ENDPOINTS=127.0.0.1:6379
# Reserved for the later event/collaboration slice; current services do not
# open NATS connections until a publisher or consumer is wired.
KC_MESSAGING_DURABLE_PROVIDER=nats
KC_MESSAGING_REALTIME_PROVIDER=nats
KC_NATS_URL=nats://127.0.0.1:4222
# Etcd registry/resolver is active. The dynamic config source remains dormant
# until a service has a typed snapshot consumer.
KC_CONFIG_PROVIDER=etcd
KC_ETCD_ENDPOINTS=127.0.0.1:2379

# Base64-encoded Ed25519 raw keys or PKCS#8/PKIX DER.
KC_IDENTITY_JWT_PRIVATE_KEY=
KC_IDENTITY_JWT_PUBLIC_KEY=
KC_GATEWAY_JWT_PUBLIC_KEY=
KC_KNOWLEDGE_JWT_PUBLIC_KEY=

# Required only until the first administrator has been created. Supply these
# through a Secret manager in deployed environments.
KC_IDENTITY_BOOTSTRAP_ADMIN_USERNAME=
KC_IDENTITY_BOOTSTRAP_ADMIN_EMAIL=
KC_IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=

# Service listeners.
KC_GATEWAY_HTTP_ADDR=:8080
KC_IDENTITY_RPC_ADDR=:8881
KC_KNOWLEDGE_RPC_ADDR=:8882
KC_PLATFORM_RPC_ADDR=:8883

# Gateway HTTP boundary. Leave trusted proxy CIDRs empty for direct local
# access; configure exact proxy networks in deployed environments. An empty
# CORS list permits same-origin requests only.
KC_GATEWAY_TRUSTED_PROXY_CIDRS=
KC_GATEWAY_CORS_ALLOWED_ORIGINS=
KC_GATEWAY_RATE_LIMIT_WINDOW=1m
KC_GATEWAY_RATE_LIMIT_GLOBAL=300
KC_GATEWAY_RATE_LIMIT_AUTH=20

# Process lifecycle and observability.
KC_SHUTDOWN_TIMEOUT=10s
KC_LOG_LEVEL=info
# Empty disables only trace export; local SDK trace/span IDs remain enabled.
# Set an absolute OTLP gRPC URL to enable export.
KC_OTEL_EXPORTER_OTLP_ENDPOINT=
KC_OTEL_TRACE_SAMPLE_RATIO=1
