# syntax=docker/dockerfile:1.7

FROM alpine:3.23.3@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659

RUN apk add --no-cache \
      bash=5.3.3-r1 \
      ca-certificates=20260611-r0 \
      curl=8.20.0-r0 \
      git=2.52.0-r0 \
      jq=1.8.1-r0 \
      kustomize=5.7.1-r9 \
      openssl=3.5.7-r0 \
    && addgroup -g 65532 -S control \
    && adduser -u 65532 -S -D -H -G control control

COPY --chmod=0555 scripts/ci /usr/local/lib/knowledge-core-ci

ENV HOME=/tmp
USER 65532:65532
ENTRYPOINT ["/bin/bash"]
