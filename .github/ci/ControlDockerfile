FROM docker.io/library/alpine:3.23.3@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659

ARG KUBECTL_VERSION=v1.36.2
ARG KUBECTL_SHA256=1e9045ec32bea85da43de85f0065358529ea7c7a152eca78154fba5b58c27d82
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

RUN sed -i 's|https://dl-cdn.alpinelinux.org/alpine|https://mirrors.aliyun.com/alpine|g' /etc/apk/repositories \
    && apk add --no-cache bash ca-certificates curl git jq kustomize openssl \
    && curl --fail --location --show-error \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
      --output /usr/local/bin/kubectl \
    && printf '%s  %s\n' "${KUBECTL_SHA256}" /usr/local/bin/kubectl | sha256sum -c - \
    && chmod 0555 /usr/local/bin/kubectl \
    && addgroup -g 65532 -S control \
    && adduser -u 65532 -S -D -H -G control control

ENV HOME=/tmp
USER 65532:65532
ENTRYPOINT ["/bin/bash"]
