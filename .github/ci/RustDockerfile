# syntax=docker/dockerfile:1.7

FROM rust:1.97.1-bookworm

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git pkg-config protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

RUN cargo install --locked cargo-deny --version 0.20.2

RUN rustup component add --toolchain 1.97.1-x86_64-unknown-linux-gnu clippy rustfmt

ENV RUSTUP_TOOLCHAIN=1.97.1-x86_64-unknown-linux-gnu
