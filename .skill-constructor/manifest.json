    {
      "id": "services.catalog",
      "revision": 125,
      "section": "services",
      "sources": [
        {
          "detail": "evidence-sha256:4861a558e13e8261cad5522bcd050aeb7c528bee7c7ce522497d57fee6c27f8e",
          "kind": "detected",
          "reference": "filesystem:service-definitions"
